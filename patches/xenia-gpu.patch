+// gta4port: GTA4_XENIA_MEMORY_LOG=1 (debugging RAM on phones): every
+// vkAllocateMemory is tallied by its caller (4 return addresses, as module
+// offsets for llvm-symbolizer), Gta4DeviceMemoryReport lists them.
+namespace {
+PFN_vkAllocateMemory gta4port_driver_allocate_memory = nullptr;
+PFN_vkFreeMemory gta4port_driver_free_memory = nullptr;
+struct Gta4MemoryCaller {
+  uint64_t bytes = 0;
+  uint32_t count = 0;
+};
+std::mutex gta4port_memory_mutex;
+std::unordered_map<VkDeviceMemory, std::pair<uint64_t, std::string>>
+    gta4port_memory_allocations;
+std::map<std::string, Gta4MemoryCaller> gta4port_memory_callers;
+
+std::string Gta4DescribeAddress(void* address) {
+#if XE_PLATFORM_WIN32
+  HMODULE module = nullptr;
+  if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                             GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                         reinterpret_cast<LPCSTR>(address), &module) &&
+      module) {
+    return fmt::format("+0x{:X}", reinterpret_cast<uintptr_t>(address) -
+                                      reinterpret_cast<uintptr_t>(module));
+  }
+#else
+  Dl_info info;
+  if (dladdr(address, &info) && info.dli_fbase) {
+    return fmt::format("+0x{:X}", reinterpret_cast<uintptr_t>(address) -
+                                      reinterpret_cast<uintptr_t>(info.dli_fbase));
+  }
+#endif
+  return fmt::format("0x{:X}", reinterpret_cast<uintptr_t>(address));
+}
+
+#if !XE_PLATFORM_WIN32
+struct Gta4UnwindState {
+  void** frames;
+  int count;
+  int max;
+};
+_Unwind_Reason_Code Gta4UnwindCallback(_Unwind_Context* context, void* arg) {
+  auto& state = *static_cast<Gta4UnwindState*>(arg);
+  if (state.count >= state.max) {
+    return _URC_END_OF_STACK;
+  }
+  state.frames[state.count++] =
+      reinterpret_cast<void*>(_Unwind_GetIP(context));
+  return _URC_NO_REASON;
+}
+#endif
+
+std::string Gta4CallerKey() {
+  void* frames[6] = {};
+  int count;
+#if XE_PLATFORM_WIN32
+  count = RtlCaptureStackBackTrace(2, 4, frames, nullptr);
+#else
+  Gta4UnwindState state = {frames, 0, 6};
+  _Unwind_Backtrace(Gta4UnwindCallback, &state);
+  // Skip this function and the wrapper.
+  count = std::max(state.count - 2, 0);
+  for (int i = 0; i < count; ++i) {
+    frames[i] = frames[i + 2];
+  }
+  count = std::min(count, 4);
+#endif
+  std::string key;
+  for (int i = 0; i < count; ++i) {
+    key += (i ? " " : "") + Gta4DescribeAddress(frames[i]);
+  }
+  return key;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL Gta4AllocateMemory(
+    VkDevice device, const VkMemoryAllocateInfo* allocate_info,
+    const VkAllocationCallbacks* allocator, VkDeviceMemory* memory) {
+  VkResult result = gta4port_driver_allocate_memory(device, allocate_info,
+                                                    allocator, memory);
+  if (result == VK_SUCCESS) {
+    std::string key = Gta4CallerKey();
+    std::lock_guard<std::mutex> lock(gta4port_memory_mutex);
+    gta4port_memory_allocations[*memory] = {allocate_info->allocationSize,
+                                            key};
+    Gta4MemoryCaller& caller = gta4port_memory_callers[key];
+    caller.bytes += allocate_info->allocationSize;
+    ++caller.count;
+  }
+  return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL Gta4FreeMemory(
+    VkDevice device, VkDeviceMemory memory,
+    const VkAllocationCallbacks* allocator) {
+  if (memory != VK_NULL_HANDLE) {
+    std::lock_guard<std::mutex> lock(gta4port_memory_mutex);
+    auto it = gta4port_memory_allocations.find(memory);
+    if (it != gta4port_memory_allocations.end()) {
+      Gta4MemoryCaller& caller = gta4port_memory_callers[it->second.second];
+      caller.bytes -= it->second.first;
+      --caller.count;
+      gta4port_memory_allocations.erase(it);
+    }
+  }
+  gta4port_driver_free_memory(device, memory, allocator);
+}
+}  // namespace
+
+std::string Gta4DeviceMemoryReport() {
+  if (!gta4port_driver_allocate_memory) {
+    return std::string();
+  }
+  std::lock_guard<std::mutex> lock(gta4port_memory_mutex);
+  std::vector<std::pair<uint64_t, const std::string*>> sorted;
+  uint64_t total = 0;
+  for (const auto& [key, caller] : gta4port_memory_callers) {
+    if (caller.count) {
+      sorted.emplace_back(caller.bytes, &key);
+      total += caller.bytes;
+    }
+  }
+  std::sort(sorted.begin(), sorted.end(),
+            [](const auto& a, const auto& b) { return a.first > b.first; });
+  std::string report =
+      fmt::format("device memory {} MB in {} allocations", total >> 20,
+                  gta4port_memory_allocations.size());
+  for (size_t i = 0; i < std::min(sorted.size(), size_t(12)); ++i) {
+    const Gta4MemoryCaller& caller = gta4port_memory_callers[*sorted[i].second];
+    report += fmt::format("\n  {:5.1f} MB in {:4} from {}",
+                          double(caller.bytes) / (1 << 20), caller.count,
+                          *sorted[i].second);
+  }
+  return report;
+}

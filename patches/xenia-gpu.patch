diff --git a/src/xenia/gpu/shaders/gta4_direct_resolve_depth_float24.ps.glsl b/src/xenia/gpu/shaders/gta4_direct_resolve_depth_float24.ps.glsl
new file mode 100644
index 0000000..734ef5b
--- /dev/null
+++ b/src/xenia/gpu/shaders/gta4_direct_resolve_depth_float24.ps.glsl
@@ -0,0 +1,49 @@
+#version 460
+#extension GL_EXT_samplerless_texture_functions : require
+// gta4port: direct resolve of a single-sampled 20e4 (float24) depth render target into a
+// k_24_8_FLOAT texture (R32_SFLOAT on the host). Reproduces dump + resolve + texture load: the
+// host depth holds guest depth / 2 ([0, 2) -> [0, 1)), the guest stores it as 20e4 (rounding to
+// the nearest even if bit 1 of flags is set, else towards zero), the texture load converts it back
+// to float32. Same arithmetic as XeFloat32To20e4 / XeFloat20e4To32 (pixel_formats.xesli).
+
+layout(set = 0, binding = 0) uniform texture2D xe_depth;
+
+layout(push_constant) uniform XeDirectResolveConstants {
+  ivec2 source_offset;
+  uint flags;
+  float exp_bias_factor;
+} xe_constants;
+
+layout(location = 0) out vec4 xe_out;
+
+uint XeFloat32To20e4(uint f32u32, bool round_to_nearest_even) {
+  f32u32 = min((f32u32 <= 0x7FFFFFFFu) ? f32u32 : 0u, 0x3FFFFFF8u);
+  uint denormalized =
+      ((f32u32 & 0x7FFFFFu) | 0x800000u) >> min(113u - (f32u32 >> 23u), 24u);
+  uint f24u32 = (f32u32 < 0x38800000u) ? denormalized : (f32u32 + 0xC8000000u);
+  if (round_to_nearest_even) {
+    f24u32 += 3u + ((f24u32 >> 3u) & 1u);
+  }
+  return (f24u32 >> 3u) & 0xFFFFFFu;
+}
+
+float XeFloat20e4To32(uint f24u32) {
+  if (f24u32 == 0u) {
+    return 0.0;
+  }
+  uint mantissa = f24u32 & 0xFFFFFu;
+  uint exponent = f24u32 >> 20u;
+  if (exponent == 0u) {
+    uint mantissa_lzcnt = 20u - uint(findMSB(mantissa));
+    exponent = 1u - mantissa_lzcnt;
+    mantissa = (mantissa << mantissa_lzcnt) & 0xFFFFFu;
+  }
+  return uintBitsToFloat(((exponent + 112u) << 23u) | (mantissa << 3u));
+}
+
+void main() {
+  float host_depth =
+      texelFetch(xe_depth, ivec2(gl_FragCoord.xy) + xe_constants.source_offset, 0).r;
+  uint f24 = XeFloat32To20e4(floatBitsToUint(host_depth * 2.0), (xe_constants.flags & 2u) != 0u);
+  xe_out = vec4(XeFloat20e4To32(f24), 0.0, 0.0, 1.0);
+}
diff --git a/src/xenia/gpu/shaders/gta4_direct_resolve_depth_float24_8888.ps.glsl b/src/xenia/gpu/shaders/gta4_direct_resolve_depth_float24_8888.ps.glsl
new file mode 100644
index 0000000..0e1b6b9
--- /dev/null
+++ b/src/xenia/gpu/shaders/gta4_direct_resolve_depth_float24_8888.ps.glsl
@@ -0,0 +1,37 @@
+#version 460
+#extension GL_EXT_samplerless_texture_functions : require
+// gta4port: direct resolve of a 20e4 depth render target into a k_8_8_8_8 texture aliasing the
+// same memory as the k_24_8_FLOAT one (GTA IV reads the stencil and the depth bytes this way). The
+// guest word is (20e4 depth << 8) | stencil, which the texture sees as R = stencil, G/B/A = the
+// depth bytes from low to high. See gta4_direct_resolve_depth_float24.ps.glsl.
+
+layout(set = 0, binding = 0) uniform texture2D xe_depth;
+layout(set = 0, binding = 1) uniform utexture2D xe_stencil;
+
+layout(push_constant) uniform XeDirectResolveConstants {
+  ivec2 source_offset;
+  uint flags;
+  float exp_bias_factor;
+} xe_constants;
+
+layout(location = 0) out vec4 xe_out;
+
+uint XeFloat32To20e4(uint f32u32, bool round_to_nearest_even) {
+  f32u32 = min((f32u32 <= 0x7FFFFFFFu) ? f32u32 : 0u, 0x3FFFFFF8u);
+  uint denormalized =
+      ((f32u32 & 0x7FFFFFu) | 0x800000u) >> min(113u - (f32u32 >> 23u), 24u);
+  uint f24u32 = (f32u32 < 0x38800000u) ? denormalized : (f32u32 + 0xC8000000u);
+  if (round_to_nearest_even) {
+    f24u32 += 3u + ((f24u32 >> 3u) & 1u);
+  }
+  return (f24u32 >> 3u) & 0xFFFFFFu;
+}
+
+void main() {
+  ivec2 coord = ivec2(gl_FragCoord.xy) + xe_constants.source_offset;
+  float host_depth = texelFetch(xe_depth, coord, 0).r;
+  uint f24 = XeFloat32To20e4(floatBitsToUint(host_depth * 2.0), (xe_constants.flags & 2u) != 0u);
+  uint stencil = texelFetch(xe_stencil, coord, 0).r & 0xFFu;
+  xe_out = vec4(float(stencil), float(f24 & 0xFFu), float((f24 >> 8u) & 0xFFu),
+                float(f24 >> 16u)) * (1.0 / 255.0);
+}
diff --git a/src/xenia/gpu/shaders/gta4_direct_resolve_float_1x.ps.glsl b/src/xenia/gpu/shaders/gta4_direct_resolve_float_1x.ps.glsl
new file mode 100644
index 0000000..cad5556
--- /dev/null
+++ b/src/xenia/gpu/shaders/gta4_direct_resolve_float_1x.ps.glsl
@@ -0,0 +1,25 @@
+#version 460
+#extension GL_EXT_samplerless_texture_functions : require
+// gta4port: direct resolve (vulkan_render_target_cache.cc, Gta4DirectResolve): writes a host render
+// target straight into the destination texture's image, doing what the guest resolve and the
+// texture load would do together (exp bias, red/blue swap), without going through guest memory.
+// Single-sampled float/unorm source (sampled through its transfer view).
+
+layout(set = 0, binding = 0) uniform texture2D xe_source;
+
+layout(push_constant) uniform XeDirectResolveConstants {
+  ivec2 source_offset;  // source pixel = destination pixel + source_offset
+  uint flags;           // bit 0: swap red and blue
+  float exp_bias_factor;
+} xe_constants;
+
+layout(location = 0) out vec4 xe_out;
+
+void main() {
+  vec4 color = texelFetch(xe_source, ivec2(gl_FragCoord.xy) + xe_constants.source_offset, 0);
+  color *= xe_constants.exp_bias_factor;
+  if ((xe_constants.flags & 1u) != 0u) {
+    color = color.bgra;
+  }
+  xe_out = color;
+}
diff --git a/src/xenia/gpu/shaders/gta4_direct_resolve_float_box2.ps.glsl b/src/xenia/gpu/shaders/gta4_direct_resolve_float_box2.ps.glsl
new file mode 100644
index 0000000..2a206f8
--- /dev/null
+++ b/src/xenia/gpu/shaders/gta4_direct_resolve_float_box2.ps.glsl
@@ -0,0 +1,27 @@
+#version 460
+#extension GL_EXT_samplerless_texture_functions : require
+// gta4port: direct resolve of a single-sampled render target that the guest resolves as 4x MSAA
+// with all samples averaged: in EDRAM a 4x pixel covers 2x2 pixels of the 1x surface, so the
+// result is a 2x2 box downsample (GTA IV's cheap half-resolution copy). source_offset is in the
+// 4x pixel grid. See gta4_direct_resolve_float_1x.ps.glsl.
+
+layout(set = 0, binding = 0) uniform texture2D xe_source;
+
+layout(push_constant) uniform XeDirectResolveConstants {
+  ivec2 source_offset;
+  uint flags;
+  float exp_bias_factor;
+} xe_constants;
+
+layout(location = 0) out vec4 xe_out;
+
+void main() {
+  ivec2 coord = (ivec2(gl_FragCoord.xy) + xe_constants.source_offset) * 2;
+  vec4 color = texelFetch(xe_source, coord, 0) + texelFetch(xe_source, coord + ivec2(1, 0), 0) +
+               texelFetch(xe_source, coord + ivec2(0, 1), 0) + texelFetch(xe_source, coord + ivec2(1, 1), 0);
+  color *= xe_constants.exp_bias_factor * 0.25;
+  if ((xe_constants.flags & 1u) != 0u) {
+    color = color.bgra;
+  }
+  xe_out = color;
+}
diff --git a/src/xenia/gpu/shaders/gta4_direct_resolve_float_ms.ps.glsl b/src/xenia/gpu/shaders/gta4_direct_resolve_float_ms.ps.glsl
new file mode 100644
index 0000000..e9c7e0d
--- /dev/null
+++ b/src/xenia/gpu/shaders/gta4_direct_resolve_float_ms.ps.glsl
@@ -0,0 +1,30 @@
+#version 460
+#extension GL_EXT_samplerless_texture_functions : require
+// gta4port: direct resolve from a multisampled float/unorm render target (see
+// gta4_direct_resolve_float_1x.ps.glsl). Bits 8-11 of flags: first sample, bits 12-15: number of
+// samples averaged (the guest copy sample select).
+
+layout(set = 0, binding = 0) uniform texture2DMS xe_source;
+
+layout(push_constant) uniform XeDirectResolveConstants {
+  ivec2 source_offset;
+  uint flags;
+  float exp_bias_factor;
+} xe_constants;
+
+layout(location = 0) out vec4 xe_out;
+
+void main() {
+  ivec2 coord = ivec2(gl_FragCoord.xy) + xe_constants.source_offset;
+  int first_sample = int((xe_constants.flags >> 8u) & 15u);
+  int sample_count = int((xe_constants.flags >> 12u) & 15u);
+  vec4 color = vec4(0.0);
+  for (int i = 0; i < sample_count; ++i) {
+    color += texelFetch(xe_source, coord, first_sample + i);
+  }
+  color *= xe_constants.exp_bias_factor / float(sample_count);
+  if ((xe_constants.flags & 1u) != 0u) {
+    color = color.bgra;
+  }
+  xe_out = color;
+}
diff --git a/src/xenia/gpu/shaders/gta4_direct_resolve_uint_1x.ps.glsl b/src/xenia/gpu/shaders/gta4_direct_resolve_uint_1x.ps.glsl
new file mode 100644
index 0000000..ca68167
--- /dev/null
+++ b/src/xenia/gpu/shaders/gta4_direct_resolve_uint_1x.ps.glsl
@@ -0,0 +1,20 @@
+#version 460
+#extension GL_EXT_samplerless_texture_functions : require
+// gta4port: direct resolve from a single-sampled k_32_FLOAT / k_32_32_FLOAT render target, whose
+// transfer view is integer (the bits of the floats). See gta4_direct_resolve_float_1x.ps.glsl.
+
+layout(set = 0, binding = 0) uniform utexture2D xe_source;
+
+layout(push_constant) uniform XeDirectResolveConstants {
+  ivec2 source_offset;
+  uint flags;
+  float exp_bias_factor;
+} xe_constants;
+
+layout(location = 0) out vec4 xe_out;
+
+void main() {
+  uvec4 bits = texelFetch(xe_source, ivec2(gl_FragCoord.xy) + xe_constants.source_offset, 0);
+  xe_out = vec4(uintBitsToFloat(bits.x), uintBitsToFloat(bits.y), 0.0, 1.0) *
+           xe_constants.exp_bias_factor;
+}

+bool DrawExtentEstimator::Gta4GetSingleRectangle(const Shader& vertex_shader,
+                                                 bool whole_pixels,
+                                                 uint32_t& left, uint32_t& top,
+                                                 uint32_t& right,
+                                                 uint32_t& bottom,
+                                                 std::optional<float>* z_out) {
+  const RegisterFile& regs = register_file_;
+  if (z_out) {
+    z_out->reset();
+  }
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (vgt_draw_initiator.prim_type != xenos::PrimitiveType::kRectangleList ||
+      vgt_draw_initiator.num_indices != 3 ||
+      vgt_draw_initiator.source_select != xenos::SourceSelect::kAutoIndex) {
+    return false;
+  }
+  if (xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode,
+                                 vgt_draw_initiator.prim_type) &&
+      regs.Get<reg::VGT_OUTPUT_PATH_CNTL>().path_select ==
+          xenos::VGTOutputPath::kTessellationEnable) {
+    return false;
+  }
+  if (!ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return false;
+  }
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (pa_su_sc_mode_cntl.vtx_window_offset_enable &&
+      regs.Get<reg::PA_SC_WINDOW_OFFSET>().value) {
+    return false;
+  }
+  uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  float scale_x = pa_cl_vte_cntl.vport_x_scale_ena
+                      ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE)
+                      : 1.0f;
+  float offset_x = pa_cl_vte_cntl.vport_x_offset_ena
+                       ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET)
+                       : 0.0f;
+  float scale_y = pa_cl_vte_cntl.vport_y_scale_ena
+                      ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE)
+                      : 1.0f;
+  float offset_y = pa_cl_vte_cntl.vport_y_offset_ena
+                       ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET)
+                       : 0.0f;
+  // Pixel centers at integers are the same as pixel centers at .5 with the
+  // positions moved by half a pixel.
+  float center_offset = regs.Get<reg::PA_SU_VTX_CNTL>().pix_center ==
+                                xenos::PixelCenter::kD3DZero
+                            ? 0.5f
+                            : 0.0f;
+  float scale_z = pa_cl_vte_cntl.vport_z_scale_ena
+                      ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZSCALE)
+                      : 1.0f;
+  float offset_z = pa_cl_vte_cntl.vport_z_offset_ena
+                       ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZOFFSET)
+                       : 0.0f;
+  std::optional<float> z_common;
+  bool z_same = true;
+  float min_x = FLT_MAX, min_y = FLT_MAX, max_x = -FLT_MAX, max_y = -FLT_MAX;
+  shader_interpreter_.SetShader(vertex_shader);
+  Gta4ExportSink export_sink;
+  shader_interpreter_.SetExportSink(&export_sink);
+  bool valid = true;
+  for (uint32_t i = 0; i < 3 && valid; ++i) {
+    uint32_t vertex_index =
+        std::min(max_index,
+                 std::max(min_index, (i + index_offset) & 0xFFFFFF));
+    export_sink.Reset();
+    shader_interpreter_.temp_registers()[0] = float(vertex_index);
+    shader_interpreter_.Execute();
+    if (export_sink.killed || (export_sink.position_mask & 0b0011) != 0b0011 ||
+        (!pa_cl_vte_cntl.vtx_xy_fmt && !(export_sink.position_mask & 0b1000))) {
+      valid = false;
+      break;
+    }
+    float x = export_sink.position[0], y = export_sink.position[1];
+    if (!pa_cl_vte_cntl.vtx_xy_fmt) {
+      x /= export_sink.position[3];
+      y /= export_sink.position[3];
+    }
+    x = x * scale_x + offset_x + center_offset;
+    y = y * scale_y + offset_y + center_offset;
+    // Rejects NaN too.
+    if (!(x >= -16384.0f && x <= 16384.0f && y >= -16384.0f &&
+          y <= 16384.0f)) {
+      valid = false;
+      break;
+    }
+    if (z_same) {
+      if ((export_sink.position_mask & 0b0100) &&
+          (pa_cl_vte_cntl.vtx_z_fmt || (export_sink.position_mask & 0b1000))) {
+        float z = export_sink.position[2];
+        if (!pa_cl_vte_cntl.vtx_z_fmt) {
+          z /= export_sink.position[3];
+        }
+        z = z * scale_z + offset_z;
+        if (!z_common) {
+          z_common = z;
+        } else if (xe::memory::Reinterpret<uint32_t>(*z_common) !=
+                   xe::memory::Reinterpret<uint32_t>(z)) {
+          z_same = false;
+        }
+      } else {
+        z_same = false;
+      }
+    }
+    min_x = std::min(min_x, x);
+    min_y = std::min(min_y, y);
+    max_x = std::max(max_x, x);
+    max_y = std::max(max_y, y);
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  if (!valid) {
+    return false;
+  }
+  if (whole_pixels) {
+    // Wholly inside, whatever the sample positions.
+    left = uint32_t(std::max(0.0f, std::ceil(min_x)));
+    top = uint32_t(std::max(0.0f, std::ceil(min_y)));
+    right = uint32_t(std::max(0.0f, std::floor(max_x)));
+    bottom = uint32_t(std::max(0.0f, std::floor(max_y)));
+  } else {
+    // The center (x + 0.5) in [min, max) - the top-left rule.
+    left = uint32_t(std::max(0.0f, std::ceil(min_x - 0.5f)));
+    top = uint32_t(std::max(0.0f, std::ceil(min_y - 0.5f)));
+    right = uint32_t(std::max(0.0f, std::ceil(max_x - 0.5f)));
+    bottom = uint32_t(std::max(0.0f, std::ceil(max_y - 0.5f)));
+  }
+  if (z_out && z_same && z_common) {
+    *z_out = z_common;
+  }
+  return left < right && top < bottom;
+}
+
+bool DrawExtentEstimator::Gta4GetConstantPixelColors(
+    const Shader& pixel_shader,
+    std::optional<std::array<float, 4>> (&colors_out)[4]) {
+  for (uint32_t i = 0; i < 4; ++i) {
+    colors_out[i].reset();
+  }
+  if (!ShaderInterpreter::CanInterpretShader(pixel_shader)) {
+    return false;
+  }
+  // Run with two different sets of inputs (interpolators and everything else
+  // read before being written), the same colors both times mean constants.
+  shader_interpreter_.SetShader(pixel_shader);
+  Gta4ExportSink export_sinks[2];
+  for (uint32_t i = 0; i < 2; ++i) {
+    float* temps = shader_interpreter_.temp_registers();
+    std::fill(temps, temps + 4 * xenos::kMaxShaderTempRegisters,
+              i ? 1234.5f : -0.25f);
+    export_sinks[i].Reset();
+    shader_interpreter_.SetExportSink(&export_sinks[i]);
+    shader_interpreter_.Execute();
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (export_sinks[0].color_masks[i] != 0b1111 ||
+        export_sinks[1].color_masks[i] != 0b1111 ||
+        std::memcmp(export_sinks[0].colors[i], export_sinks[1].colors[i],
+                    sizeof(float) * 4)) {
+      continue;
+    }
+    std::array<float, 4> color;
+    std::memcpy(color.data(), export_sinks[0].colors[i], sizeof(float) * 4);
+    colors_out[i] = color;
+  }
+  return true;
+}

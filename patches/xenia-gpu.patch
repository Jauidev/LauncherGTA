+  std::vector<uint8_t> width(bound, 4);        // Components of a value / type.
+  std::vector<uint8_t> is_float32(bound, 0);   // Float scalar / vector types and values.
+  std::vector<uint8_t> builtin_frag_coord(bound, 0), builtin(bound, 0);

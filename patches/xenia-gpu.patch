+    view_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+    view_create_info.image = image_;
+    view_create_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    view_create_info.format = gta4_attachment_format_;
+    view_create_info.subresourceRange =
+        ui::vulkan::util::InitializeSubresourceRange();
+    if (dfn.vkCreateImageView(device, &view_create_info, nullptr,
+                              &gta4_attachment_view_) != VK_SUCCESS) {
+      gta4_attachment_view_ = VK_NULL_HANDLE;
+      return VK_NULL_HANDLE;
+    }
+  }
+  VkFramebufferCreateInfo framebuffer_create_info = {};
+  framebuffer_create_info.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+  framebuffer_create_info.renderPass = render_pass;
+  framebuffer_create_info.attachmentCount = 1;
+  framebuffer_create_info.pAttachments = &gta4_attachment_view_;
+  framebuffer_create_info.width = key().GetWidth();
+  framebuffer_create_info.height = key().GetHeight();
+  framebuffer_create_info.layers = 1;
+  if (dfn.vkCreateFramebuffer(device, &framebuffer_create_info, nullptr,
+                              &gta4_framebuffer_) != VK_SUCCESS) {
+    gta4_framebuffer_ = VK_NULL_HANDLE;
+  }
+  return gta4_framebuffer_;
+}
+
+uint32_t VulkanTextureCache::Gta4DirectResolveMask() {
+  // GTA4_XENIA_DIRECT_RESOLVE: bit mask of the direct resolve kinds, 1 color,
+  // 2 the 2x2 box downsample (1x surface resolved as 4x), 4 float24 depth.
+  static const uint32_t mask = [] {
+    const char* setting = std::getenv("GTA4_XENIA_DIRECT_RESOLVE");
+    return setting ? uint32_t(std::strtoul(setting, nullptr, 0)) : 0u;
+  }();
+  return mask;
+}
+
+bool VulkanTextureCache::Gta4DirectResolveEnabled() {
+  return Gta4DirectResolveMask() != 0;
+}
+
+bool VulkanTextureCache::Gta4FindDirectResolveTargets(
+    uint32_t dest_base, uint32_t dest_pitch, xenos::TextureFormat dest_format,
+    xenos::Endian dest_endian, VkRect2D rect, uint32_t extent_start,
+    uint32_t extent_length, bool depth_source,
+    std::vector<Gta4DirectResolveTarget>& out) {
+  out.clear();
+  const FormatInfo* format_info = FormatInfo::Get(dest_format);
+  if (!format_info || format_info->block_width != 1 ||
+      format_info->block_height != 1 || !dest_pitch || (dest_pitch & 31)) {
+    return false;
+  }
+  extent_start &= 0x1FFFFFFF;
+  const uint32_t extent_end = extent_start + extent_length;
+  const uint64_t now = Gta4CurrentSubmissionTime();
+  bool blocked = false;
+  // A tiled 2D surface is stored as rows of 32x32 macro tiles, so the guest
+  // resolve of rows y... of a texture with the same pitch starts y rows (a
+  // multiple of 32) further in memory.
+  const uint32_t row_bytes = dest_pitch * format_info->bits_per_pixel / 8;
+  dest_base &= 0x1FFFFFFF;
+  Gta4ForEachTexture([&](Texture& texture) {
+    auto& vulkan_texture = static_cast<VulkanTexture&>(texture);
+    const TextureKey& key = texture.key();
+    const uint32_t texture_base = key.base_page << 12;
+    const uint32_t texture_end = texture_base + texture.GetGuestBaseSize();
+    bool overlaps = texture_base < extent_end && extent_start < texture_end;
+    if (key.mip_max_level && key.mip_page) {
+      const uint32_t mips_base = key.mip_page << 12;
+      overlaps |= mips_base < extent_end &&
+                  extent_start < mips_base + texture.GetGuestMipsSize();
+    }
+    if (!overlaps) {
+      return;
+    }
+    // Something the direct write cannot update: block it if it is in use.
+    auto unusable = [&]() {
+      if (now - texture.last_usage_time() < 2000) {
+        blocked = true;
+      }
+    };
+    const bool depth_alias =
+        depth_source && key.format == xenos::TextureFormat::k_8_8_8_8 &&
+        vulkan_texture.gta4_attachment_format() == VK_FORMAT_R8G8B8A8_UNORM;
+    if (vulkan_texture.gta4_attachment_format() == VK_FORMAT_UNDEFINED ||
+        (key.format != dest_format && !depth_alias) ||
+        key.endianness != dest_endian || key.pitch * 32 != dest_pitch ||
+        texture.base_outdated_lockless() || dest_base < texture_base) {
+      unusable();
+      return;
+    }
+    const uint32_t delta = dest_base - texture_base;
+    if (delta % (row_bytes * 32)) {
+      unusable();
+      return;
+    }
+    const uint32_t row_offset = delta / row_bytes;
+    const uint32_t width = key.GetWidth(), height = key.GetHeight();
+    const uint32_t x = uint32_t(rect.offset.x);
+    const uint32_t y = row_offset + uint32_t(rect.offset.y);
+    if (x >= width || y >= height) {
+      unusable();
+      return;
+    }
+    Gta4DirectResolveTarget target;
+    target.texture = &vulkan_texture;
+    target.format = vulkan_texture.gta4_attachment_format();
+    target.width = width;
+    target.height = height;
+    target.region.offset.x = int32_t(x);
+    target.region.offset.y = int32_t(y);
+    target.region.extent.width = std::min(rect.extent.width, width - x);
+    target.region.extent.height = std::min(rect.extent.height, height - y);
+    out.push_back(target);
+  });
+  if (blocked) {
+    out.clear();
+    return false;
+  }
+  return true;
+}
+
+VkFramebuffer VulkanTextureCache::Gta4BeginDirectResolveWrite(
+    const Gta4DirectResolveTarget& target, VkRenderPass render_pass) {
+  auto& vulkan_texture = *static_cast<VulkanTexture*>(target.texture);
+  VkFramebuffer framebuffer = vulkan_texture.Gta4GetFramebuffer(render_pass);
+  if (framebuffer == VK_NULL_HANDLE) {
+    return VK_NULL_HANDLE;
+  }
+  vulkan_texture.MarkAsUsed();
+  VulkanTexture::Usage old_usage =
+      vulkan_texture.SetUsage(VulkanTexture::Usage::kGta4ColorAttachment);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kGta4ColorAttachment,
+                       dst_stage_mask, dst_access_mask, new_layout);
+  // Also between two direct resolves into one texture (write after write).
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_texture.image(), ui::vulkan::util::InitializeSubresourceRange(),
+      src_stage_mask, dst_stage_mask, src_access_mask, dst_access_mask,
+      old_layout, new_layout);
+  return framebuffer;
+}

+                       (opcode >= 103 && opcode <= 107) ||
+                       (opcode >= 305 && opcode <= 315);
+    if (image && has_result) {
+      for (uint32_t index = 4; index < words; ++index) {
+        seeds.push_back({w[index], 15});
+      }

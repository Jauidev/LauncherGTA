+// gta4port: GTA4_XENIA_MASK="feature,feature" hides device features (debugging:
+// makes a desktop GPU behave like the phone's).
+static bool Gta4FeatureMasked(const char* name) {
+  const char* list = std::getenv("GTA4_XENIA_MASK");
+  if (!list) {
+    return false;
+  }
+  const std::string padded = "," + std::string(list) + ",";
+  return padded.find("," + std::string(name) + ",") != std::string::npos;
+}

+// gta4port (debugging): see Gta4ProbeRenderTarget in the header.
+void VulkanRenderTargetCache::Gta4ProbeRenderTarget(RenderTarget* render_target,
+                                                    const char* label) {
+  auto& rt = *static_cast<VulkanRenderTarget*>(render_target);
+  RenderTargetKey key = rt.key();
+  if (key.msaa_samples != xenos::MsaaSamples::k1X || gta4_probes_.size() >= 64) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device =
+      command_processor_.GetVulkanDevice();
+  const bool is_64bpp = key.Is64bpp();
+  const uint32_t width = key.GetWidth();
+  const uint32_t height = std::min(
+      uint32_t(720),
+      GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples));
+  const VkDeviceSize size = VkDeviceSize(width) * height * (is_64bpp ? 8 : 4);
+  Gta4Probe probe;
+  probe.width = width;
+  probe.height = height;
+  probe.key = key;
+  probe.label = label;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, probe.buffer,
+          probe.memory)) {
+    return;
+  }
+
+  command_processor_.EndRenderPass();
+  const VkImageAspectFlags aspect =
+      key.is_depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT;
+  VkImageSubresourceRange range = {};
+  range.aspectMask = key.is_depth
+                         ? VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT
+                         : VK_IMAGE_ASPECT_COLOR_BIT;
+  range.levelCount = 1;
+  range.layerCount = 1;
+  command_processor_.PushImageMemoryBarrier(
+      rt.image(), range, rt.current_stage_mask(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+      rt.current_access_mask(), VK_ACCESS_TRANSFER_READ_BIT,
+      rt.current_layout(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  rt.SetUsage(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+              VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  VkBufferImageCopy region = {};
+  region.imageSubresource.aspectMask = aspect;
+  region.imageSubresource.layerCount = 1;
+  region.imageExtent.width = width;
+  region.imageExtent.height = height;
+  region.imageExtent.depth = 1;
+  command_processor_.deferred_command_buffer().CmdVkCopyImageToBuffer(
+      rt.image(), VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, probe.buffer, region);
+  gta4_probes_.push_back(std::move(probe));
+}
+
+void VulkanRenderTargetCache::Gta4LogAndFreeProbes() {
+  const ui::vulkan::VulkanDevice* const vulkan_device =
+      command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (const Gta4Probe& probe : gta4_probes_) {
+    void* mapping;
+    if (dfn.vkMapMemory(device, probe.memory, 0, VK_WHOLE_SIZE, 0, &mapping) ==
+        VK_SUCCESS) {
+      VkMappedMemoryRange mapped_range = {};
+      mapped_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      mapped_range.memory = probe.memory;
+      mapped_range.size = VK_WHOLE_SIZE;
+      dfn.vkInvalidateMappedMemoryRanges(device, 1, &mapped_range);
+      const auto* words = static_cast<const uint32_t*>(mapping);
+      const bool is_64bpp = probe.key.Is64bpp();
+      const size_t count =
+          size_t(probe.width) * probe.height * (is_64bpp ? 2 : 1);
+      size_t nonzero = 0;
+      float depth_min = 1e30f, depth_max = -1e30f;
+      for (size_t i = 0; i < count; ++i) {
+        nonzero += words[i] != 0;
+        if (probe.key.is_depth) {
+          float depth;
+          if (GetDepthVulkanFormat(probe.key.GetDepthFormat()) ==
+              VK_FORMAT_D24_UNORM_S8_UINT) {
+            depth = float(words[i] & 0xFFFFFF) / float(0xFFFFFF);
+          } else {
+            std::memcpy(&depth, &words[i], sizeof(depth));
+          }
+          depth_min = std::min(depth_min, depth);
+          depth_max = std::max(depth_max, depth);
+        }
+      }
+      if (probe.key.is_depth) {
+        XELOGI("gta4gpu: probe {} D base {} pitch {}: nonzero {:.1f}%, host depth {:.6f}..{:.6f}",
+               probe.label, uint32_t(probe.key.base_tiles),
+               uint32_t(probe.key.pitch_tiles_at_32bpp),
+               100.0 * nonzero / count, depth_min, depth_max);
+      } else {
+        XELOGI("gta4gpu: probe {} C{} base {} pitch {}: nonzero {:.1f}%",
+               probe.label, uint32_t(probe.key.resource_format),
+               uint32_t(probe.key.base_tiles),
+               uint32_t(probe.key.pitch_tiles_at_32bpp),
+               100.0 * nonzero / count);
+      }
+      dfn.vkUnmapMemory(device, probe.memory);
+    }
+    dfn.vkDestroyBuffer(device, probe.buffer, nullptr);
+    dfn.vkFreeMemory(device, probe.memory, nullptr);
+  }
+  gta4_probes_.clear();
+}

+uint32_t RenderTargetCache::Gta4GetOverwrittenRenderTargets(
+    uint32_t rts_used_bits, reg::RB_DEPTHCONTROL normalized_depth_control,
+    uint32_t normalized_color_mask, const bool* rts_keep_depth_bits,
+    const Shader& vertex_shader, Transfer::Rectangle& rectangle_out,
+    uint32_t& uniform_known_out, uint64_t* uniform_bits_out,
+    bool& depth_keeping_stencil_out) {
+  uniform_known_out = 0;
+  depth_keeping_stencil_out = false;
+  static const bool enabled = [] {
+    const char* setting = std::getenv("GTA4_XENIA_SKIP_OVERWRITTEN_TRANSFERS");
+    return !setting || setting[0] != '0';
+  }();
+  if (!enabled || !rts_used_bits) {
+    return 0;
+  }
+  const RegisterFile& regs = register_file();
+  // Every sample of every pixel of the rectangle reaches the output merger.
+  if ((regs[XE_GPU_REG_PA_SC_AA_MASK] & 0xFFFF) != 0xFFFF) {
+    return 0;
+  }
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (pa_su_sc_mode_cntl.cull_front || pa_su_sc_mode_cntl.cull_back) {
+    return 0;
+  }
+  auto rb_colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  if (rb_colorcontrol.alpha_to_mask_enable) {
+    return 0;
+  }
+  const Shader* pixel_shader = gta4_draw_pixel_shader_;
+  std::optional<std::array<float, 4>> pixel_colors[4];
+  bool pixel_colors_known = false;
+  if (pixel_shader) {
+    if (pixel_shader->kills_pixels()) {
+      return 0;
+    }
+    pixel_colors_known = draw_extent_estimator_.Gta4GetConstantPixelColors(
+        *pixel_shader, pixel_colors);
+    if (pixel_shader->writes_color_target(0) &&
+        rb_colorcontrol.alpha_test_enable &&
+        rb_colorcontrol.alpha_func != xenos::CompareFunction::kAlways) {
+      if (!pixel_colors[0]) {
+        return 0;
+      }
+      std::optional<float> alpha = (*pixel_colors[0])[3];
+      float reference = regs.Get<float>(XE_GPU_REG_RB_ALPHA_REF);
+      bool passed = false;
+      switch (rb_colorcontrol.alpha_func) {
+        case xenos::CompareFunction::kLess:
+          passed = *alpha < reference;
+          break;
+        case xenos::CompareFunction::kEqual:
+          passed = *alpha == reference;
+          break;
+        case xenos::CompareFunction::kLessEqual:
+          passed = *alpha <= reference;
+          break;
+        case xenos::CompareFunction::kGreater:
+          passed = *alpha > reference;
+          break;
+        case xenos::CompareFunction::kNotEqual:
+          passed = *alpha != reference;
+          break;
+        case xenos::CompareFunction::kGreaterEqual:
+          passed = *alpha >= reference;
+          break;
+        default:
+          break;
+      }
+      if (!passed) {
+        return 0;
+      }
+    }
+  }
+  // The depth / stencil test must pass everywhere.
+  const reg::RB_DEPTHCONTROL& depth_control = normalized_depth_control;
+  if (rts_used_bits & 1) {
+    if (depth_control.z_enable &&
+        depth_control.zfunc != xenos::CompareFunction::kAlways) {
+      return 0;
+    }
+    if (depth_control.stencil_enable &&
+        (depth_control.stencilfunc != xenos::CompareFunction::kAlways ||
+         (depth_control.backface_enable &&
+          depth_control.stencilfunc_bf != xenos::CompareFunction::kAlways))) {
+      return 0;
+    }
+  }
+  uint32_t overwritten = 0;
+  if (rts_used_bits & 1) {
+    // Depth and stencil both written everywhere.
+    auto stencil_written = [](xenos::StencilOp op, uint32_t write_mask) {
+      return (op == xenos::StencilOp::kReplace ||
+              op == xenos::StencilOp::kZero) &&
+             (write_mask & 0xFF) == 0xFF;
+    };
+    if (depth_control.z_enable && depth_control.z_write_enable &&
+        depth_control.stencil_enable &&
+        stencil_written(depth_control.stencilzpass,
+                        regs.Get<reg::RB_STENCILREFMASK>().stencilwritemask) &&
+        (!depth_control.backface_enable ||
+         stencil_written(depth_control.stencilzpass_bf,
+                         regs.Get<reg::RB_STENCILREFMASK>(
+                                 XE_GPU_REG_RB_STENCILREFMASK_BF)
+                             .stencilwritemask))) {
+      overwritten |= 1;
+    }
+  }
+  // Depth written everywhere, but the stencil kept (not an overwrite, the
+  // stencil still has to be transferred, but a uniform range stays uniform).
+  auto stencil_kept = [](xenos::StencilOp op, uint32_t write_mask) {
+    return op == xenos::StencilOp::kKeep || !(write_mask & 0xFF);
+  };
+  bool depth_keeping_stencil =
+      (rts_used_bits & 1) && !(overwritten & 1) && depth_control.z_enable &&
+      depth_control.z_write_enable &&
+      (!depth_control.stencil_enable ||
+       (stencil_kept(depth_control.stencilzpass,
+                     regs.Get<reg::RB_STENCILREFMASK>().stencilwritemask) &&
+        (!depth_control.backface_enable ||
+         stencil_kept(depth_control.stencilzpass_bf,
+                      regs.Get<reg::RB_STENCILREFMASK>(
+                              XE_GPU_REG_RB_STENCILREFMASK_BF)
+                          .stencilwritemask))));
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (!(rts_used_bits & (uint32_t(1) << (1 + i))) ||
+        ((normalized_color_mask >> (4 * i)) & 0b1111) != 0b1111 ||
+        rts_keep_depth_bits[1 + i]) {
+      continue;
+    }
+    // No blending (source * 1 + destination * 0 for both color and alpha).
+    static constexpr Register kBlendControls[] = {
+        XE_GPU_REG_RB_BLENDCONTROL0, XE_GPU_REG_RB_BLENDCONTROL1,
+        XE_GPU_REG_RB_BLENDCONTROL2, XE_GPU_REG_RB_BLENDCONTROL3};
+    if ((regs[kBlendControls[i]] & 0x1FFF1FFF) != 0x00010001) {
+      continue;
+    }
+    overwritten |= uint32_t(1) << (1 + i);
+  }
+  if (!overwritten && !depth_keeping_stencil) {
+    return 0;
+  }
+  uint32_t left, top, right, bottom;
+  std::optional<float> rectangle_z;
+  if (!draw_extent_estimator_.Gta4GetSingleRectangle(
+          vertex_shader,
+          regs.Get<reg::RB_SURFACE_INFO>().msaa_samples !=
+              xenos::MsaaSamples::k1X,
+          left, top, right, bottom, &rectangle_z)) {
+    return 0;
+  }
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  left = std::max(left, scissor.offset[0]);
+  top = std::max(top, scissor.offset[1]);
+  right = std::min(right, scissor.offset[0] + scissor.extent[0]);
+  bottom = std::min(bottom, scissor.offset[1] + scissor.extent[1]);
+  if (left >= right || top >= bottom) {
+    return 0;
+  }
+  rectangle_out.x_pixels = left;
+  rectangle_out.y_pixels = top;
+  rectangle_out.width_pixels = right - left;
+  rectangle_out.height_pixels = bottom - top;
+
+  // The values written, as guest EDRAM bits, where known.
+  static const bool uniform_enabled = [] {
+    const char* setting = std::getenv("GTA4_XENIA_UNIFORM_TRANSFERS");
+    return !setting || setting[0] != '0';
+  }();
+  if (!uniform_enabled) {
+    return overwritten;
+  }
+  if (vulkan::gta4port_log_transfer_lines) {
+    XELOGI(
+        "gta4gpu: overwrite rectangle {}x{} at {},{} z {} format {} "
+        "overwritten {:X} depth keeping stencil {}",
+        right - left, bottom - top, left, top,
+        rectangle_z ? *rectangle_z : -1.0f,
+        uint32_t(regs.Get<reg::RB_DEPTH_INFO>().depth_format), overwritten,
+        int(depth_keeping_stencil));
+  }
+  if ((overwritten & 1) || depth_keeping_stencil) {
+    depth_keeping_stencil_out = depth_keeping_stencil;
+  }
+  if (((overwritten & 1) || depth_keeping_stencil) && rectangle_z &&
+      !(pixel_shader && pixel_shader->writes_depth())) {
+    // Stencil: the same reference for both faces, or no back face stencil.
+    auto stencil_ref = regs.Get<reg::RB_STENCILREFMASK>();
+    auto stencil_ref_bf =
+        regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF);
+    auto stencil_value = [](xenos::StencilOp op, uint32_t ref) {
+      return op == xenos::StencilOp::kReplace ? (ref & 0xFF) : 0u;
+    };
+    uint32_t stencil = stencil_value(normalized_depth_control.stencilzpass,
+                                     stencil_ref.stencilref);
+    bool stencil_known =
+        !normalized_depth_control.backface_enable ||
+        stencil_value(normalized_depth_control.stencilzpass_bf,
+                      stencil_ref_bf.stencilref) == stencil;
+    float z = *rectangle_z;
+    // Clears put 0 as a tiny negative number sometimes (-2^-28).
+    if (z < 0.0f && z > -1.0e-6f) {
+      z = 0.0f;
+    }
+    uint32_t depth = UINT32_MAX;
+    switch (regs.Get<reg::RB_DEPTH_INFO>().depth_format) {
+      case xenos::DepthRenderTargetFormat::kD24S8:
+        if (z >= 0.0f && z <= 1.0f) {
+          depth = uint32_t(z * float(0xFFFFFF) + 0.5f);
+        }
+        break;
+      case xenos::DepthRenderTargetFormat::kD24FS8:
+        if (z >= 0.0f && z < 2.0f) {
+          depth = xenos::Float32To20e4(z, true);
+        }
+        break;
+    }
+    if ((stencil_known || depth_keeping_stencil) && depth <= 0xFFFFFF) {
+      // With the stencil kept, the caller takes it from the previous value.
+      uniform_known_out |= 1;
+      uniform_bits_out[0] =
+          (uint64_t(depth) << 8) | (depth_keeping_stencil ? 0 : stencil);
+    }
+  }
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (!((overwritten >> (1 + i)) & 1) || !pixel_colors_known ||
+        !pixel_colors[i]) {
+      continue;
+    }
+    const std::array<float, 4>& color = *pixel_colors[i];
+    auto color_info = regs.Get<reg::RB_COLOR_INFO>(
+        reg::RB_COLOR_INFO::rt_register_indices[i]);
+    bool zero = true;
+    for (float component : color) {
+      if (xe::memory::Reinterpret<uint32_t>(component)) {
+        zero = false;
+      }
+    }
+    if (zero) {
+      // All bits 0 in every format.
+      uniform_known_out |= uint32_t(1) << (1 + i);
+      uniform_bits_out[1 + i] = 0;
+      continue;
+    }
+    if (color_info.color_exp_bias) {
+      continue;
+    }
+    switch (color_info.color_format) {
+      case xenos::ColorRenderTargetFormat::k_8_8_8_8: {
+        uint64_t bits = 0;
+        for (uint32_t j = 0; j < 4; ++j) {
+          float component = std::min(std::max(color[j], 0.0f), 1.0f);
+          bits |= uint64_t(uint32_t(component * 255.0f + 0.5f)) << (8 * j);
+        }
+        uniform_known_out |= uint32_t(1) << (1 + i);
+        uniform_bits_out[1 + i] = bits;
+      } break;
+      case xenos::ColorRenderTargetFormat::k_32_FLOAT:
+        uniform_known_out |= uint32_t(1) << (1 + i);
+        uniform_bits_out[1 + i] = xe::memory::Reinterpret<uint32_t>(color[0]);
+        break;
+      default:
+        break;
+    }
+  }
+  return overwritten;
+}

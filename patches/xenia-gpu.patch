+void RenderTargetCache::Gta4SetUniform(RenderTarget* render_target,
+                                       const Transfer::Rectangle* rectangle,
+                                       uint64_t bits) {
+  if (!render_target) {
+    return;
+  }
+  render_target->gta4_uniform = rectangle != nullptr;
+  if (rectangle) {
+    render_target->gta4_uniform_x = rectangle->x_pixels;
+    render_target->gta4_uniform_y = rectangle->y_pixels;
+    render_target->gta4_uniform_width = rectangle->width_pixels;
+    render_target->gta4_uniform_height = rectangle->height_pixels;
+    render_target->gta4_uniform_bits = bits;
+  }
+}
+
+bool RenderTargetCache::Gta4GetUniformTransferBits(RenderTargetKey source,
+                                                   uint32_t start_tiles,
+                                                   uint32_t end_tiles,
+                                                   RenderTargetKey dest,
+                                                   uint64_t& bits_out) const {
+  auto source_it = render_targets_.find(source);
+  if (source_it == render_targets_.end() || !source_it->second ||
+      !source_it->second->gta4_uniform) {
+    return false;
+  }
+  const RenderTarget& source_rt = *source_it->second;
+  uint64_t bits = source_rt.gta4_uniform_bits;
+  // Reinterpreting the bits like the transfer would, only when certain of the
+  // layout: the same format, or between depth formats (the same 24:8 layout),
+  // or 0 (0 everywhere).
+  if (bits) {
+    if (source.is_depth != dest.is_depth ||
+        (!source.is_depth && source.resource_format != dest.resource_format)) {
+      return false;
+    }
+  }
+  // The whole range must be inside the rectangle known to be uniform.
+  Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithoutCutout];
+  uint32_t rectangle_count =
+      Transfer::GetRangeRectangles(start_tiles, end_tiles, source, rectangles);
+  if (!rectangle_count) {
+    return false;
+  }
+  for (uint32_t i = 0; i < rectangle_count; ++i) {
+    const Transfer::Rectangle& rectangle = rectangles[i];
+    if (rectangle.x_pixels < source_rt.gta4_uniform_x ||
+        rectangle.y_pixels < source_rt.gta4_uniform_y ||
+        rectangle.x_pixels + rectangle.width_pixels >
+            source_rt.gta4_uniform_x + source_rt.gta4_uniform_width ||
+        rectangle.y_pixels + rectangle.height_pixels >
+            source_rt.gta4_uniform_y + source_rt.gta4_uniform_height) {
+      return false;
+    }
+  }
+  bits_out = bits;
+  return true;
+}

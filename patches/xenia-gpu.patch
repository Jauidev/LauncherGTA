-      semaphores_free_.pop_back();
-      current_submission_wait_stage_masks_.push_back(
-          sparse_bind_wait_stage_mask_);
-      sparse_bind_wait_stage_mask_ = 0;
-      sparse_buffer_binds_.clear();
-      sparse_memory_binds_.clear();

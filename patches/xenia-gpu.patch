+// gta4port: GTA4_XENIA_GPU_TIME=1 measures how long the GPU spends on the
+// emulation's command buffers: a timestamp at the start and at the end of each
+// submission, read back once the submission has completed. Every 2 s the log
+// gives the share of time the GPU was busy (union of the submission intervals)
+// and the GPU time per guest frame, independently of the GPU clock.
+namespace {
+struct Gta4GpuTimer {
+  static constexpr uint32_t kSlots = 64;
+  bool initialized = false;
+  bool enabled = false;
+  VkQueryPool pool = VK_NULL_HANDLE;
+  double period_ns = 1.0;
+  uint32_t next_slot = 0;
+  // Submission index and query slot of the submissions not read back yet.
+  std::deque<std::pair<uint64_t, uint32_t>> pending;
+  uint64_t last_end = 0;
+  uint64_t busy_ticks = 0;
+  uint32_t submissions = 0;
+  std::chrono::steady_clock::time_point window_start;
+  uint64_t window_start_frame = 0;
+};

+bool VulkanRenderTargetCache::Gta4DirectResolve(
+    const draw_util::ResolveInfo& resolve_info,
+    VulkanTextureCache& texture_cache) {
+  // In GTA4_XENIA_RESOLVE_LOG frames, why a resolve takes the normal path.
+  auto reject = [&resolve_info](const char* reason) {
+    if (gta4port_log_transfers || gta4port_log_transfer_lines) {
+      XELOGI("gta4gpu: direct resolve rejected ({}): dest 0x{:08X}", reason,
+             resolve_info.copy_dest_base);
+    }
+    return false;
+  };
+  if (!VulkanTextureCache::Gta4DirectResolveEnabled() ||
+      GetPath() != Path::kHostRenderTargets || IsDrawResolutionScaled()) {
+    return false;
+  }
+  const bool is_depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo& edram_info =
+      is_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  const reg::RB_COPY_DEST_INFO& dest_info = resolve_info.copy_dest_info;
+  const xenos::CopyCommand copy_command =
+      resolve_info.rb_copy_control.copy_command;
+  if (dest_info.copy_dest_array ||
+      uint32_t(dest_info.copy_dest_endian) > uint32_t(xenos::Endian::k16in32) ||
+      (copy_command != xenos::CopyCommand::kRaw &&
+       copy_command != xenos::CopyCommand::kConvert)) {
+    return reject("copy command or destination layout");
+  }
+
+  // The source render target format and the destination texture format must be
+  // a pair whose resolve + texture load is what the shader reproduces.
+  auto source_format = xenos::ColorRenderTargetFormat(edram_info.format);
+  auto dest_format = xenos::TextureFormat(uint32_t(dest_info.copy_dest_format));
+  Gta4DirectResolveShader shader = Gta4DirectResolveShader::kFloat1x;
+  if (is_depth) {
+    // 20e4 depth to a k_24_8_FLOAT texture (GTA IV's G-buffer and scene depth).
+    if (xenos::DepthRenderTargetFormat(edram_info.format) !=
+            xenos::DepthRenderTargetFormat::kD24FS8 ||
+        dest_format != xenos::TextureFormat::k_24_8_FLOAT ||
+        edram_info.msaa_samples != xenos::MsaaSamples::k1X) {
+      return reject("depth format pair");
+    }
+    shader = Gta4DirectResolveShader::kDepthFloat24;
+  } else switch (source_format) {
+    case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+      if (dest_format != xenos::TextureFormat::k_8_8_8_8) {
+        return reject("format pair");
+      }
+      shader = Gta4DirectResolveShader::kFloat1x;
+      break;
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT:
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT_AS_16_16_16_16:
+      // To float16 (HDR), or to 8_8_8_8 (the final image: the attachment
+      // clamps to [0, 1] like the guest conversion does).
+      if ((dest_format != xenos::TextureFormat::k_16_16_16_16_FLOAT &&
+           dest_format != xenos::TextureFormat::k_8_8_8_8) ||
+          copy_command != xenos::CopyCommand::kConvert) {
+        return reject("format pair");
+      }
+      shader = Gta4DirectResolveShader::kFloat1x;
+      break;
+    case xenos::ColorRenderTargetFormat::k_32_FLOAT:
+      if (dest_format != xenos::TextureFormat::k_32_FLOAT) {
+        return false;
+      }
+      shader = Gta4DirectResolveShader::kUint1x;
+      break;
+    case xenos::ColorRenderTargetFormat::k_32_32_FLOAT:
+      if (dest_format != xenos::TextureFormat::k_32_32_FLOAT) {
+        return false;
+      }
+      shader = Gta4DirectResolveShader::kUint1x;
+      break;
+    default:
+      return reject("format pair");
+  }
+  // Samples: 1x, or 4x with a single sample or an average (2x has a different
+  // host sample layout depending on the device; left to the normal path).
+  uint32_t first_sample = 0, sample_count = 1;
+  if (edram_info.msaa_samples == xenos::MsaaSamples::k4X) {
+    if (shader != Gta4DirectResolveShader::kFloat1x) {
+      return false;
+    }
+    shader = Gta4DirectResolveShader::kFloatMsaa;
+    switch (resolve_info.copy_dest_coordinate_info.copy_sample_select) {
+      case xenos::CopySampleSelect::k0:
+      case xenos::CopySampleSelect::k1:
+      case xenos::CopySampleSelect::k2:
+      case xenos::CopySampleSelect::k3:
+        first_sample = uint32_t(
+            resolve_info.copy_dest_coordinate_info.copy_sample_select);
+        break;
+      case xenos::CopySampleSelect::k01:
+        sample_count = 2;
+        break;
+      case xenos::CopySampleSelect::k23:
+        first_sample = 2;
+        sample_count = 2;
+        break;
+      case xenos::CopySampleSelect::k0123:
+        sample_count = 4;
+        break;
+      default:
+        return false;
+    }
+  } else if (edram_info.msaa_samples != xenos::MsaaSamples::k1X) {
+    return false;
+  }
+
+  const uint32_t width = resolve_info.coordinate_info.width_div_8 * 8;
+  const uint32_t height = resolve_info.height_div_8 * 8;
+  // Tiny resolves (luminance measurement, 1x1...) may be read back by the CPU.
+  if (width * height <= 64 * 64) {
+    return false;
+  }
+
+  // The source must be one render target owning the whole region.
+  uint32_t dump_base, dump_row_length_used, dump_rows, dump_pitch;
+  resolve_info.GetCopyEdramTileSpan(dump_base, dump_row_length_used, dump_rows,
+                                    dump_pitch);
+  GetResolveCopyRectanglesToDump(dump_base, dump_row_length_used, dump_rows,
+                                 dump_pitch, gta4_direct_resolve_rectangles_);
+  if (gta4_direct_resolve_rectangles_.empty()) {
+    return reject("no source render target");
+  }
+  RenderTarget* source_rt = gta4_direct_resolve_rectangles_.front().render_target;
+  for (const ResolveCopyDumpRectangle& rectangle :
+       gta4_direct_resolve_rectangles_) {
+    if (rectangle.render_target != source_rt) {
+      return reject("several source render targets");
+    }
+  }
+  auto& source_vulkan_rt = *static_cast<VulkanRenderTarget*>(source_rt);
+  const RenderTargetKey rt_key = source_vulkan_rt.key();
+  // Xenia stores both 7e3 variants in the same host render target.
+  auto same_resource = [](xenos::ColorRenderTargetFormat format) {
+    return format == xenos::ColorRenderTargetFormat::
+                         k_2_10_10_10_FLOAT_AS_16_16_16_16
+               ? xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT
+               : format;
+  };
+  // A 1x render target resolved as 4x with all samples averaged: 2x2 box.
+  if (shader == Gta4DirectResolveShader::kFloatMsaa && sample_count == 4 &&
+      !rt_key.is_depth && rt_key.msaa_samples == xenos::MsaaSamples::k1X) {
+    shader = Gta4DirectResolveShader::kFloatBox2;
+  }
+  const bool rt_format_matches =
+      is_depth ? rt_key.is_depth && rt_key.GetDepthFormat() ==
+                                        xenos::DepthRenderTargetFormat::kD24FS8
+               : !rt_key.is_depth && same_resource(rt_key.GetColorFormat()) ==
+                                         same_resource(source_format);
+  if (!rt_format_matches ||
+      (rt_key.msaa_samples != edram_info.msaa_samples &&
+       shader != Gta4DirectResolveShader::kFloatBox2) ||
+      rt_key.GetPitchTiles() != edram_info.pitch_tiles) {
+    if (gta4port_log_transfers || gta4port_log_transfer_lines) {
+      XELOGI(
+          "gta4gpu: direct resolve key: rt format {} msaa {} pitch {} base {} "
+          "depth {} | resolve format {} msaa {} pitch {} base {}",
+          rt_key.resource_format, uint32_t(rt_key.msaa_samples),
+          rt_key.GetPitchTiles(), rt_key.base_tiles, rt_key.is_depth,
+          edram_info.format, uint32_t(edram_info.msaa_samples),
+          edram_info.pitch_tiles, edram_info.base_tiles);
+    }
+    return reject("source render target key");
+  }
+  // In the pixel grid of the resolve's sample count (for the 2x2 box case the
+  // shader doubles the coordinates into the 1x render target).
+  const uint32_t tile_width =
+      (xenos::kEdramTileWidthSamples >>
+       uint32_t(edram_info.msaa_samples >= xenos::MsaaSamples::k4X)) >>
+      uint32_t(rt_key.Is64bpp());
+  const uint32_t tile_height =
+      xenos::kEdramTileHeightSamples >>
+      uint32_t(edram_info.msaa_samples >= xenos::MsaaSamples::k2X);
+  const uint32_t tile_index =
+      rt_key.GetNonWrappedTileIndex(edram_info.base_tiles) - rt_key.base_tiles;
+  const int32_t source_x =
+      int32_t((tile_index % edram_info.pitch_tiles) * tile_width +
+              resolve_info.coordinate_info.edram_offset_x_div_8 * 8);
+  const int32_t source_y =
+      int32_t((tile_index / edram_info.pitch_tiles) * tile_height +
+              resolve_info.coordinate_info.edram_offset_y_div_8 * 8);
+
+  const uint32_t kind_bit =
+      shader == Gta4DirectResolveShader::kDepthFloat24
+          ? 4u
+          : (shader == Gta4DirectResolveShader::kFloatBox2 ? 2u : 1u);
+  if (!(VulkanTextureCache::Gta4DirectResolveMask() & kind_bit)) {
+    return reject("kind disabled");
+  }
+
+  // Destination textures.
+  VkRect2D dest_rect;
+  dest_rect.offset.x =
+      int32_t(resolve_info.copy_dest_coordinate_info.offset_x_div_8 * 8);
+  dest_rect.offset.y =
+      int32_t(resolve_info.copy_dest_coordinate_info.offset_y_div_8 * 8);
+  dest_rect.extent.width = width;
+  dest_rect.extent.height = height;
+  if (!texture_cache.Gta4FindDirectResolveTargets(
+          resolve_info.copy_dest_base,
+          resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32 * 32,
+          dest_format, xenos::Endian(uint32_t(dest_info.copy_dest_endian)),
+          dest_rect, resolve_info.copy_dest_extent_start,
+          resolve_info.copy_dest_extent_length, is_depth,
+          gta4_direct_resolve_targets_)) {
+    ++gta4_normal_resolve_count_;
+    return reject("aliased by another texture");
+  }
+  if (gta4_direct_resolve_targets_.empty()) {
+    ++gta4_normal_resolve_count_;
+    return reject("no destination texture");
+  }
+
+  // Depth into the k_8_8_8_8 alias packs the stencil and the depth bytes.
+  auto target_shader =
+      [shader](const VulkanTextureCache::Gta4DirectResolveTarget& target) {
+        return shader == Gta4DirectResolveShader::kDepthFloat24 &&
+                       target.format == VK_FORMAT_R8G8B8A8_UNORM
+                   ? Gta4DirectResolveShader::kDepthFloat24As8888
+                   : shader;
+      };
+  // Get everything that can fail before recording anything.
+  for (const VulkanTextureCache::Gta4DirectResolveTarget& target :
+       gta4_direct_resolve_targets_) {
+    if (!Gta4GetDirectResolvePipeline(target_shader(target), target.format)) {
+      return false;
+    }
+  }
+
+  DeferredCommandBuffer& command_buffer =
+      command_processor_.deferred_command_buffer();
+  TransitionRenderTarget(source_vulkan_rt, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                         VK_ACCESS_SHADER_READ_BIT,
+                         VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  struct {
+    int32_t source_offset[2];
+    uint32_t flags;
+    float exp_bias_factor;
+  } constants;
+  constants.flags = uint32_t(dest_info.copy_dest_swap) | (first_sample << 8) |
+                    (sample_count << 12);
+  if (is_depth) {
+    // Rounding of the dump (see DumpRenderTargets / PreClampedDepthTo20e4).
+    constants.flags = (!depth_float24_convert_in_pixel_shader() &&
+                       depth_float24_round())
+                          ? 2u
+                          : 0u;
+  }
+  const VkPipelineLayout pipeline_layout =
+      is_depth ? gta4_direct_resolve_pipeline_layout_depth_
+               : gta4_direct_resolve_pipeline_layout_;
+  constants.exp_bias_factor = std::ldexp(1.0f, dest_info.copy_dest_exp_bias);
+  VkDescriptorSet source_descriptor_set =
+      source_vulkan_rt.GetDescriptorSetTransferSource();
+  for (const VulkanTextureCache::Gta4DirectResolveTarget& target :
+       gta4_direct_resolve_targets_) {
+    const bool whole = !target.region.offset.x && !target.region.offset.y &&
+                       target.region.extent.width == target.width &&
+                       target.region.extent.height == target.height;
+    VkRenderPass render_pass =
+        Gta4GetDirectResolveRenderPass(target.format, whole);
+    VkFramebuffer framebuffer =
+        texture_cache.Gta4BeginDirectResolveWrite(target, render_pass);
+    if (framebuffer == VK_NULL_HANDLE) {
+      continue;
+    }
+    // Ends the current render pass and flushes the barriers above.
+    command_processor_.SubmitBarriers(true);
+    VkRenderPassBeginInfo render_pass_begin_info = {};
+    render_pass_begin_info.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+    render_pass_begin_info.renderPass = render_pass;
+    render_pass_begin_info.framebuffer = framebuffer;
+    render_pass_begin_info.renderArea = target.region;
+    command_buffer.CmdVkBeginRenderPass(&render_pass_begin_info,
+                                        VK_SUBPASS_CONTENTS_INLINE);
+    command_processor_.BindExternalGraphicsPipeline(
+        Gta4GetDirectResolvePipeline(target_shader(target), target.format));
+    VkViewport viewport;
+    viewport.x = 0.0f;
+    viewport.y = 0.0f;
+    viewport.width = float(target.width);
+    viewport.height = float(target.height);
+    viewport.minDepth = 0.0f;
+    viewport.maxDepth = 1.0f;
+    command_processor_.SetViewport(viewport);
+    command_processor_.SetScissor(target.region);
+    command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                           pipeline_layout, 0, 1,
+                                           &source_descriptor_set, 0, nullptr);
+    // Source pixel = texture pixel - region origin + source origin.
+    constants.source_offset[0] = source_x - target.region.offset.x;
+    constants.source_offset[1] = source_y - target.region.offset.y;
+    command_buffer.CmdVkPushConstants(pipeline_layout,
+                                      VK_SHADER_STAGE_FRAGMENT_BIT, 0,
+                                      sizeof(constants), &constants);
+    command_buffer.CmdVkDraw(3, 1, 0, 0);
+    command_buffer.CmdVkEndRenderPass();
+  }
+  if (!(++gta4_direct_resolve_count_ & 1023)) {
+    XELOGI("gta4gpu: {} direct resolves, {} without a destination texture",
+           gta4_direct_resolve_count_, gta4_normal_resolve_count_);
+  }
+  return true;
+}
+
+VkRenderPass VulkanRenderTargetCache::Gta4GetDirectResolveRenderPass(
+    VkFormat format, bool whole) {
+  const uint64_t render_pass_key = uint64_t(format) | (uint64_t(whole) << 32);
+  auto it = gta4_direct_resolve_render_passes_.find(render_pass_key);
+  if (it != gta4_direct_resolve_render_passes_.end()) {
+    return it->second;
+  }
+  VkAttachmentDescription attachment = {};
+  attachment.format = format;
+  attachment.samples = VK_SAMPLE_COUNT_1_BIT;
+  // The region may be a part of the texture (the other part comes from another
+  // resolve), and the render area keeps the rest untouched.
+  attachment.loadOp =
+      whole ? VK_ATTACHMENT_LOAD_OP_DONT_CARE : VK_ATTACHMENT_LOAD_OP_LOAD;
+  attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+  attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+  attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+  attachment.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  attachment.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  VkAttachmentReference color_reference = {
+      0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+  VkSubpassDescription subpass = {};
+  subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+  subpass.colorAttachmentCount = 1;
+  subpass.pColorAttachments = &color_reference;
+  VkRenderPassCreateInfo render_pass_create_info = {};
+  render_pass_create_info.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+  render_pass_create_info.attachmentCount = 1;
+  render_pass_create_info.pAttachments = &attachment;
+  render_pass_create_info.subpassCount = 1;
+  render_pass_create_info.pSubpasses = &subpass;
+  const ui::vulkan::VulkanDevice* const vulkan_device =
+      command_processor_.GetVulkanDevice();
+  VkRenderPass render_pass = VK_NULL_HANDLE;
+  if (vulkan_device->functions().vkCreateRenderPass(
+          vulkan_device->device(), &render_pass_create_info, nullptr,
+          &render_pass) != VK_SUCCESS) {
+    XELOGE("gta4gpu: failed to create the direct resolve render pass");
+    render_pass = VK_NULL_HANDLE;
+  }
+  gta4_direct_resolve_render_passes_.emplace(render_pass_key, render_pass);
+  return render_pass;
+}
+
+VkPipeline VulkanRenderTargetCache::Gta4GetDirectResolvePipeline(
+    Gta4DirectResolveShader shader, VkFormat format) {
+  const uint64_t pipeline_key = (uint64_t(shader) << 32) | uint32_t(format);
+  auto it = gta4_direct_resolve_pipelines_.find(pipeline_key);
+  if (it != gta4_direct_resolve_pipelines_.end()) {
+    return it->second;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device =
+      command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkPipeline pipeline = VK_NULL_HANDLE;
+  // Cached as null too, so a failure is not retried on every resolve.
+  gta4_direct_resolve_pipelines_.emplace(pipeline_key, VK_NULL_HANDLE);
+
+  if (gta4_direct_resolve_pipeline_layout_ == VK_NULL_HANDLE) {
+    VkPushConstantRange push_constant_range;
+    VkPipelineLayout* layouts[] = {&gta4_direct_resolve_pipeline_layout_,
+                                   &gta4_direct_resolve_pipeline_layout_depth_};
+    const VkDescriptorSetLayout set_layouts[] = {
+        descriptor_set_layout_sampled_image_,
+        descriptor_set_layout_sampled_image_x2_};
+    push_constant_range.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+    push_constant_range.offset = 0;
+    push_constant_range.size = sizeof(uint32_t) * 4;
+    VkPipelineLayoutCreateInfo layout_create_info = {};
+    layout_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout_create_info.setLayoutCount = 1;
+    layout_create_info.pushConstantRangeCount = 1;
+    layout_create_info.pPushConstantRanges = &push_constant_range;
+    for (size_t i = 0; i < 2; ++i) {
+      layout_create_info.pSetLayouts = &set_layouts[i];
+      if (dfn.vkCreatePipelineLayout(device, &layout_create_info, nullptr,
+                                     layouts[i]) != VK_SUCCESS) {
+        *layouts[i] = VK_NULL_HANDLE;
+        return VK_NULL_HANDLE;
+      }
+    }
+  }
+  if (gta4_direct_resolve_vertex_shader_ == VK_NULL_HANDLE) {
+    gta4_direct_resolve_vertex_shader_ = ui::vulkan::util::CreateShaderModule(
+        vulkan_device, shaders::fullscreen_cw_vs,
+        sizeof(shaders::fullscreen_cw_vs));
+  }
+  VkShaderModule& fragment_shader =
+      gta4_direct_resolve_fragment_shaders_[size_t(shader)];
+  if (fragment_shader == VK_NULL_HANDLE) {
+    switch (shader) {
+      case Gta4DirectResolveShader::kFloat1x:
+        fragment_shader = ui::vulkan::util::CreateShaderModule(
+            vulkan_device, shaders::gta4_direct_resolve_float_1x_ps,
+            sizeof(shaders::gta4_direct_resolve_float_1x_ps));
+        break;
+      case Gta4DirectResolveShader::kFloatMsaa:
+        fragment_shader = ui::vulkan::util::CreateShaderModule(
+            vulkan_device, shaders::gta4_direct_resolve_float_ms_ps,
+            sizeof(shaders::gta4_direct_resolve_float_ms_ps));
+        break;
+      case Gta4DirectResolveShader::kUint1x:
+        fragment_shader = ui::vulkan::util::CreateShaderModule(
+            vulkan_device, shaders::gta4_direct_resolve_uint_1x_ps,
+            sizeof(shaders::gta4_direct_resolve_uint_1x_ps));
+        break;
+      case Gta4DirectResolveShader::kDepthFloat24As8888:
+        fragment_shader = ui::vulkan::util::CreateShaderModule(
+            vulkan_device, shaders::gta4_direct_resolve_depth_float24_8888_ps,
+            sizeof(shaders::gta4_direct_resolve_depth_float24_8888_ps));
+        break;
+      case Gta4DirectResolveShader::kDepthFloat24:
+        fragment_shader = ui::vulkan::util::CreateShaderModule(
+            vulkan_device, shaders::gta4_direct_resolve_depth_float24_ps,
+            sizeof(shaders::gta4_direct_resolve_depth_float24_ps));
+        break;
+      case Gta4DirectResolveShader::kFloatBox2:
+        fragment_shader = ui::vulkan::util::CreateShaderModule(
+            vulkan_device, shaders::gta4_direct_resolve_float_box2_ps,
+            sizeof(shaders::gta4_direct_resolve_float_box2_ps));
+        break;
+      default:
+        break;
+    }
+  }
+  VkRenderPass render_pass = Gta4GetDirectResolveRenderPass(format);
+  if (gta4_direct_resolve_vertex_shader_ == VK_NULL_HANDLE ||
+      fragment_shader == VK_NULL_HANDLE || render_pass == VK_NULL_HANDLE) {
+    return VK_NULL_HANDLE;
+  }
+
+  VkPipelineShaderStageCreateInfo stages[2] = {};
+  stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+  stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+  stages[0].module = gta4_direct_resolve_vertex_shader_;
+  stages[0].pName = "main";
+  stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+  stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+  stages[1].module = fragment_shader;
+  stages[1].pName = "main";
+  VkPipelineVertexInputStateCreateInfo vertex_input = {};
+  vertex_input.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+  VkPipelineInputAssemblyStateCreateInfo input_assembly = {};
+  input_assembly.sType =
+      VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+  input_assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+  VkPipelineViewportStateCreateInfo viewport_state = {};
+  viewport_state.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+  viewport_state.viewportCount = 1;
+  viewport_state.scissorCount = 1;
+  VkPipelineRasterizationStateCreateInfo rasterization = {};
+  rasterization.sType =
+      VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+  rasterization.polygonMode = VK_POLYGON_MODE_FILL;
+  rasterization.cullMode = VK_CULL_MODE_NONE;
+  rasterization.frontFace = VK_FRONT_FACE_CLOCKWISE;
+  rasterization.lineWidth = 1.0f;
+  VkPipelineMultisampleStateCreateInfo multisample = {};
+  multisample.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+  multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+  VkPipelineColorBlendAttachmentState blend_attachment = {};
+  blend_attachment.colorWriteMask =
+      VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+      VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+  VkPipelineColorBlendStateCreateInfo color_blend = {};
+  color_blend.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+  color_blend.attachmentCount = 1;
+  color_blend.pAttachments = &blend_attachment;
+  const VkDynamicState dynamic_states[] = {VK_DYNAMIC_STATE_VIEWPORT,
+                                           VK_DYNAMIC_STATE_SCISSOR};
+  VkPipelineDynamicStateCreateInfo dynamic_state = {};
+  dynamic_state.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+  dynamic_state.dynamicStateCount = uint32_t(xe::countof(dynamic_states));
+  dynamic_state.pDynamicStates = dynamic_states;
+  VkGraphicsPipelineCreateInfo pipeline_create_info = {};
+  pipeline_create_info.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+  pipeline_create_info.stageCount = 2;
+  pipeline_create_info.pStages = stages;
+  pipeline_create_info.pVertexInputState = &vertex_input;
+  pipeline_create_info.pInputAssemblyState = &input_assembly;
+  pipeline_create_info.pViewportState = &viewport_state;
+  pipeline_create_info.pRasterizationState = &rasterization;
+  pipeline_create_info.pMultisampleState = &multisample;
+  pipeline_create_info.pColorBlendState = &color_blend;
+  pipeline_create_info.pDynamicState = &dynamic_state;
+  pipeline_create_info.layout =
+      (shader == Gta4DirectResolveShader::kDepthFloat24 ||
+       shader == Gta4DirectResolveShader::kDepthFloat24As8888)
+          ? gta4_direct_resolve_pipeline_layout_depth_
+          : gta4_direct_resolve_pipeline_layout_;
+  pipeline_create_info.renderPass = render_pass;
+  pipeline_create_info.subpass = 0;
+  pipeline_create_info.basePipelineIndex = -1;
+  if (dfn.vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                    &pipeline_create_info, nullptr,
+                                    &pipeline) != VK_SUCCESS) {
+    XELOGE("gta4gpu: failed to create a direct resolve pipeline");
+    return VK_NULL_HANDLE;
+  }
+  gta4_direct_resolve_pipelines_[pipeline_key] = pipeline;
+  return pipeline;
+}
+
+void VulkanRenderTargetCache::Gta4ShutdownDirectResolve() {
+  const ui::vulkan::VulkanDevice* const vulkan_device =
+      command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (auto& pipeline_pair : gta4_direct_resolve_pipelines_) {
+    if (pipeline_pair.second != VK_NULL_HANDLE) {
+      dfn.vkDestroyPipeline(device, pipeline_pair.second, nullptr);
+    }
+  }
+  gta4_direct_resolve_pipelines_.clear();
+  for (auto& render_pass_pair : gta4_direct_resolve_render_passes_) {
+    if (render_pass_pair.second != VK_NULL_HANDLE) {
+      dfn.vkDestroyRenderPass(device, render_pass_pair.second, nullptr);
+    }
+  }
+  gta4_direct_resolve_render_passes_.clear();
+  for (VkShaderModule& module : gta4_direct_resolve_fragment_shaders_) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyShaderModule, device,
+                                           module);
+  }
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyShaderModule, device,
+                                         gta4_direct_resolve_vertex_shader_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device,
+                                         gta4_direct_resolve_pipeline_layout_);
+  ui::vulkan::util::DestroyAndNullHandle(
+      dfn.vkDestroyPipelineLayout, device,
+      gta4_direct_resolve_pipeline_layout_depth_);
+}

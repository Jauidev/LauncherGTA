+void DrawExtentEstimator::Gta4ExportSink::Export(
+    ucode::ExportRegister export_register, const float* value,
+    uint32_t value_mask) {
+  // Vertex and pixel shader export registers overlap, the sink is used for
+  // one kind at a time.
+  if (export_register == ucode::ExportRegister::kVSPosition) {
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (value_mask & (uint32_t(1) << i)) {
+        position[i] = value[i];
+      }
+    }
+    position_mask |= value_mask;
+  } else if (export_register ==
+             ucode::ExportRegister::kVSPointSizeEdgeFlagKillVertex) {
+    if ((value_mask & 0b0100) &&
+        (xe::memory::Reinterpret<uint32_t>(value[2]) & ~(UINT32_C(1) << 31))) {
+      killed = true;
+    }
+  } else if (uint32_t(export_register) <=
+             uint32_t(ucode::ExportRegister::kPSColor3)) {
+    uint32_t target = uint32_t(export_register);
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (value_mask & (uint32_t(1) << i)) {
+        colors[target][i] = value[i];
+      }
+    }
+    color_masks[target] |= value_mask;
+  }
+}

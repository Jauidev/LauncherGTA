+void SpirvShaderTranslator::DecodeTextureFetchConstants(
+    const uint32_t* fetch_constants, TextureFetchDecoded* decoded) {
+  // Same arithmetic as the translated code that doesn't use these values.
+  auto signed_bits = [](uint32_t value, uint32_t offset, uint32_t count) {
+    return int32_t(value << (32 - offset - count)) >> (32 - count);
+  };
+  for (uint32_t i = 0; i < 32; ++i) {
+    const uint32_t* words = fetch_constants + 6 * i;
+    TextureFetchDecoded& out = decoded[i];
+    uint32_t mip_min_level = (words[4] >> 2) & 15;
+    bool mip_locked = mip_min_level == ((words[4] >> 6) & 15);
+    for (uint32_t j = 0; j < 2; ++j) {
+      uint32_t size = ((words[2] >> (13 * j)) & ((1 << 13) - 1)) + 1;
+      out.size_2d[j] = float(size);
+      out.size_2d_rcp[j] = 1.0f / out.size_2d[j];
+      out.size_2d_mip_locked[j] = float(
+          mip_locked ? std::max(size >> mip_min_level, uint32_t(1)) : size);
+    }
+    out.padding_1[0] = out.padding_1[1] = 0.0f;
+    out.exp_bias = std::ldexp(1.0f, signed_bits(words[3], 13, 6));
+    out.lod = float(signed_bits(words[4], 12, 10)) * (1.0f / 32.0f);
+    for (uint32_t j = 0; j < 2; ++j) {
+      out.grad_exp_adjust[j] = float(signed_bits(words[4], 22 + 5 * j, 5));
+      out.lod_gradient_scale[j] =
+          std::exp2(out.lod + out.grad_exp_adjust[j]);
+    }
+    out.grad_exp_adjust_max =
+        std::max(out.grad_exp_adjust[0], out.grad_exp_adjust[1]);
+    out.padding_0 = 0.0f;
+  }
+}
+
+bool SpirvShaderTranslator::IsTextureFetchDecodeEnabled() {
+  // Off by default: on the Mali-G615 (driver r44p1) it gives no measurable
+  // gain, the driver already evaluates uniform-only code once per draw.
+  // =2 (experiment, wrong for signed or integer-scaled textures) always takes
+  // the unsigned-only branch, so the generic code is dead.
+  return GetTextureFetchDecodeSetting() != 0;
+}
+
+int SpirvShaderTranslator::GetTextureFetchDecodeSetting() {
+  static const int setting = [] {
+    const char* value = std::getenv("GTA4_XENIA_FETCH_DECODE");
+    return value ? std::atoi(value) : 0;
+  }();
+  return setting;
+}
+
+spv::Id SpirvShaderTranslator::LoadTextureFetchDecoded(uint32_t fetch_constant,
+                                                       uint32_t float_index) {
+  constexpr uint32_t kVectorsPerConstant =
+      sizeof(TextureFetchDecoded) / (sizeof(float) * 4);
+  id_vector_temp_.clear();
+  id_vector_temp_.push_back(builder_->makeIntConstant(1));
+  id_vector_temp_.push_back(builder_->makeIntConstant(
+      int(fetch_constant * kVectorsPerConstant + (float_index >> 2))));
+  id_vector_temp_.push_back(builder_->makeIntConstant(int(float_index & 3)));
+  return builder_->createLoad(
+      builder_->createAccessChain(spv::StorageClassUniform,
+                                  uniform_fetch_constants_, id_vector_temp_),
+      spv::NoPrecision);
+}
+
+bool SpirvShaderTranslator::IsTextureSpecializationEnabled() {
+  static const bool enabled = [] {
+    const char* setting = std::getenv("GTA4_XENIA_TEXTURE_SPEC");
+    return !setting || std::strcmp(setting, "0") != 0;
+  }();
+  return enabled;
+}
+
+spv::Id SpirvShaderTranslator::GetTextureKindSpecConstant(
+    uint32_t fetch_constant) {
+  spv::Id& spec_constant = texture_kind_spec_constants_[fetch_constant];
+  if (spec_constant == spv::NoResult) {
+    spec_constant = builder_->makeUintConstant(0, true);
+    builder_->addDecoration(
+        spec_constant, spv::DecorationSpecId,
+        int(kSpecializationConstantTextureKind + fetch_constant));
+    builder_->addName(spec_constant,
+                      fmt::format("xe_texture{}_kind", fetch_constant).c_str());
+  }
+  return spec_constant;
+}
+
 size_t SpirvShaderTranslator::FindOrAddTextureBinding(

+void VulkanRenderTargetCache::Gta4UseEdramBufferForDump(uint32_t first_tile,
+                                                        uint32_t tile_count) {
+  // gta4port: a dump writing tiles that the previous resolve copy didn't read
+  // doesn't need to wait for that copy (write-after-read on other tiles).
+  if (Gta4RangeBarriersEnabled() &&
+      edram_buffer_usage_ == EdramBufferUsage::kComputeRead &&
+      !Gta4EdramSpansOverlap(first_tile, tile_count,
+                             gta4_compute_read_first_tile_,
+                             gta4_compute_read_tile_count_)) {
+    edram_buffer_usage_ = EdramBufferUsage::kComputeWrite;
+    return;
+  }
+  UseEdramBuffer(EdramBufferUsage::kComputeWrite);
+}

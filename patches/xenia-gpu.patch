+    const char* value = std::getenv("GTA4_XENIA_TIGHT_RENDER_AREA");
+    return value ? value[0] : '1';
+  }();
+  bool enabled = mode != '0';
+  if (mode == 'a') {
+    static int last_phase = -1;
+    const int phase = int(std::chrono::duration_cast<std::chrono::seconds>(
+                              std::chrono::steady_clock::now().time_since_epoch())
+                              .count() /
+                          10 % 2);
+    enabled = phase == 0;
+    if (phase != last_phase) {
+      last_phase = phase;
+      XELOGI("gta4gpu: tight render area {}", enabled ? "on" : "off");
+    }
+  }
+  if (enabled) {
+    ShrinkRenderArea();
+  }
+  WriteCommand(Command::kVkEndRenderPass, 0);

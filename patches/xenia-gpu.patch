-          bool gamma_ramp_has_upload_buffer =
-              gamma_ramp_upload_buffer_memory_ != VK_NULL_HANDLE;
-          ui::vulkan::util::FlushMappedMemoryRange(
-              vulkan_device,
-              gamma_ramp_has_upload_buffer ? gamma_ramp_upload_buffer_memory_

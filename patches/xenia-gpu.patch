+bool VulkanRenderTargetCache::Gta4RangeBarriersEnabled() {
+  static const bool enabled = [] {
+    // Off by default: measured without a gain on the Mali-G615 (the
+    // conservative spans overlap too often).
+    const char* setting = std::getenv("GTA4_XENIA_RANGE_BARRIERS");
+    return setting && setting[0] == '1';
+  }();
+  return enabled;
+}
+
+namespace {
+// gta4port: whether two spans of EDRAM tiles, both possibly wrapping around
+// the end of the EDRAM, share any tile.
+bool Gta4EdramSpansOverlap(uint32_t first_a, uint32_t count_a,
+                           uint32_t first_b, uint32_t count_b) {
+  constexpr uint32_t kTiles = xenos::kEdramTileCount;
+  if (!count_a || !count_b) {
+    return false;
+  }
+  if (count_a >= kTiles || count_b >= kTiles) {
+    return true;
+  }
+  first_a %= kTiles;
+  first_b %= kTiles;
+  // Distance from a's start to b's start going forward; b starts inside a, or
+  // a starts inside b.
+  uint32_t b_from_a = (first_b + kTiles - first_a) % kTiles;
+  uint32_t a_from_b = (first_a + kTiles - first_b) % kTiles;
+  return b_from_a < count_a || a_from_b < count_b;
+}
+}  // namespace

diff --git a/XenonUtils/ppc_context.h b/XenonUtils/ppc_context.h
index 31a86cd..21d4961 100644
--- a/XenonUtils/ppc_context.h
+++ b/XenonUtils/ppc_context.h
@@ -5,6 +5,7 @@
 #error "ppc_config.h must be included before ppc_context.h"
 #endif
 
+#include <chrono>
 #include <climits>
 #include <cmath>
 #include <csetjmp>
@@ -700,4 +701,22 @@ inline uint64_t __rdtsc()
 #   error "Missing implementation for __rdtsc()"
 #endif
 
+// gta4port: mftb. Games divide timebase deltas by KeQueryPerformanceFrequency, which reports the
+// console's 49.875 MHz; the raw TSC (GHz) or cntvct (tens of MHz) made every game timer run at the
+// wrong speed. Whole seconds and the remainder are scaled apart so nothing overflows (and no
+// 128-bit division, which clang-cl would leave to a helper the MSVC linker lacks).
+inline uint64_t PPCReadTimebase()
+{
+    constexpr uint64_t TIMEBASE_FREQUENCY = 49875000;
+#if defined(__aarch64__) || defined(_M_ARM64)
+    uint64_t frequency;
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(frequency));
+    const uint64_t ticks = __rdtsc();
+#else
+    constexpr uint64_t frequency = 1000000000;
+    const uint64_t ticks = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+#endif
+    return ticks / frequency * TIMEBASE_FREQUENCY + ticks % frequency * TIMEBASE_FREQUENCY / frequency;
+}
+
 #endif
